# 数据库连接
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/diary_platform

# JWT 密钥（生产环境务必修改）
SECRET_KEY=your-secret-key-change-in-production

# Fernet 对称加密密钥（生成方式: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=

# 定时备份：默认每天 Asia/Shanghai 02:00 执行，应用启动不补执行
BACKUP_STORAGE_PATH=backup_packages
BACKUP_SCHEDULE_TIME=02:00
BACKUP_SCHEDULE_TIMEZONE=Asia/Shanghai

# 大模型单个业务步骤的最大总调用次数。1 表示失败后不自动重试。
LLM_MAX_ATTEMPTS=1

# 语音转写运行参数。模型、API 地址和密钥在管理端配置。
# TRANSCRIPTION_PUBLIC_BASE_URL 必须能被模型服务公网访问，生产环境使用 HTTPS
TRANSCRIPTION_PUBLIC_BASE_URL=http://your-public-host
TRANSCRIPTION_MAX_FILE_SIZE=314572800
TRANSCRIPTION_MAX_CONCURRENCY=3
TRANSCRIPTION_FAILED_RETENTION_DAYS=7
TRANSCRIPTION_DOWNLOAD_TOKEN_HOURS=24

# MinIO 语音临时文件存储
MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=diary_minio
MINIO_SECRET_KEY=diary_minio_password
MINIO_BUCKET=diary
MINIO_SECURE=false
MINIO_PUBLIC_SECURE=false
MINIO_UPLOAD_PREFIX=transcriptions
