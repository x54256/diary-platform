{
  "point_work": {
    "ed44ebb3-7f19-4f30-9f4f-d5dea56f15ee": {
      "candidate": {
        "title": "与小豪聊天并了解其分手原因",
        "points": [
          {
            "no": 1,
            "summary": "小豪突然宣布分手并来南通",
            "detail": "下午与小豪聊天时，他在群里突然表示要分手了，计划来南通玩，并想了解我们项目的实施情况。我调侃他不想我，他否认了。随后他主动提起分手一事，我立即出去给他打电话询问原因，主要是出于八卦。"
          },
          {
            "no": 2,
            "summary": "小豪列举分手的两点主要原因",
            "detail": "小豪告诉我分手主要基于两件事：一是他女朋友情绪不稳定，经常因小事发火，在一起时不开心；二是女方特别喜欢花钱，且逼迫他上交财务——婚前给一部分，婚后要求全部。小豪给了她四五万元，结果被迅速花光，查看账单发现全是数百元的小额支出，累积起来总额很大。"
          },
          {
            "no": 3,
            "summary": "对比男女不同的消费模式",
            "detail": "我认同小豪的观察，认为男女消费模式确实存在差异：男性倾向于购买大件或贵重物品，账单按金额排序能立即看出大头支出；而女性可能前两条是两三万，后面跟着大量几十、几百元的小额消费，累积起来也会迅速花光积蓄。"
          },
          {
            "no": 4,
            "summary": "小豪因价值观不合当天提出分手",
            "detail": "由于觉得双方价值观不符且女方情绪不稳定，小豪决定不再继续这段感情，并于当天正式向女朋友提出了分手。"
          },
          {
            "no": 5,
            "summary": "建议非暴力沟通但认为小豪没救",
            "detail": "我给小豪推荐《非暴力沟通》，建议他用这种方式处理矛盾：不要因为对方有情绪就对着干导致争吵升级，花钱的问题也应通过非暴力沟通解决，前提是女方愿意好好沟通。但于福豪（小豪）表示女方是销售出身，非常擅长沟通，一直对他进行PUA。我听后认为他这种情况已经没救了。"
          },
          {
            "no": 6,
            "summary": "发现前女友与前男友联系成为导火索",
            "detail": "小豪还发现他女朋友仍与前男友保持联系，虽然他确信两人不可能复合，但这件事成为了分手的契机和导火索，他借此发火生气，顺势提出了分手。"
          },
          {
            "no": 7,
            "summary": "建议利用拆屋效应谈判财务管理",
            "detail": "我建议小豪在财务问题上采用各花各的模式，类似我目前的经济模式，并利用拆屋效应：先坚持提分手让对方不同意、不高兴，等对方回来谈判时，再提出以后各管各的钱，让她不要到处借钱、尽量节省。但小豪表示女方虽然每次都答应得很好，实际依然如故，月底还是没钱要花他的钱，这是他无法接受的。"
          },
          {
            "no": 8,
            "summary": "分享自己帮前任还债的类似经历",
            "detail": "我分享了自己的经历：之前颂梅装修花费巨大，欠债约15万元。当时她每月月光，我问原因，她说工资一发就要还债。我提出帮她还清债务，让她借此机会攒钱。结果她现在虽然不再借新债，但仍是月光状态，只是每月能稍微攒一点点。我认为这无所谓，反正是她自己的钱，由她自己安排，只要不再出去借钱就好。"
          }
        ]
      },
