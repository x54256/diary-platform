{
  "name": "diary-platform-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "NUXT_APP_BASE_URL=/secret/ NUXT_PUBLIC_API_BASE=/diary/api nuxt build",
    "dev": "NUXT_APP_BASE_URL=/secret/ NUXT_PUBLIC_API_BASE=http://localhost:8000/diary/api nuxt dev",
    "test": "node --test tests/*.test.ts",
    "generate": "NUXT_APP_BASE_URL=/secret/ NUXT_PUBLIC_API_BASE=/diary/api nuxt generate",
    "preview": "NUXT_APP_BASE_URL=/secret/ NUXT_PUBLIC_API_BASE=http://localhost:8000/diary/api nuxt preview",
    "postinstall": "nuxt prepare"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.10.0",
    "@types/markdown-it": "^14.1.2",
    "nuxt": "^3.9.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@pinia/nuxt": "^0.5.0",
    "markdown-it": "^14.3.0",
    "pinia": "^2.1.0"
  }
}
