        "points": [
          {
            "id": "e03e08f7-e325-5f24-a7e3-5474ba1e5a70",
            "no": 1,
            "summary": "昨晚用投影看《星际穿越》，觉得题材新颖、故事好看",
            "detail": "昨晚遛狗回家想休息，没怎么玩僵尸。想到投影仪，让颂梅打开，问有何会员，她让我找腾讯视频。不知看什么，翻了一阵决定先看豆瓣 Top 250，选诺兰的《星际穿越》。感觉他好像都导这种科幻。\n\n我觉得电影不太现实，没太考虑现实人性的复杂，较理想化、侧重科幻，但题材新颖，故事好看。按我的理解：地球将毁灭，主角星际穿越找宜居地，返航能源不足，留下同行女伴自己回去，掉进黑洞。未来人为他建了五维空间，他借此联系女儿，传回信息，让女儿解出人类上天的公式，最终全人类离开地球。",
            "embedding_sha256": "d4a145cff973d5159ae24804f7c9828cfb07fc990d6a24fc0b778a947a1442a7"
          },
          {
            "id": "c6f494aa-8b1a-5554-af00-11a1d2c91008",
            "no": 2,
            "summary": "说不清电影为何排第六，想到也许需考虑时代背景",
            "detail": "颂梅问《星际穿越》值不值豆瓣第六，我说不知道，还没到能评价电影的程度。我觉得好看，却说不清排名原因。也许需放回当时背景，2014 年便提出这些并搬上银幕，可能因开创性而显得厉害。",
            "embedding_sha256": "12475daadd58f6f2fc30e0368b5a64190de89eb0ac0e0843ea37250b24a2f885"
          },
          {
            "id": "362f4e34-cf47-5dca-9d42-a0b31cd916bf",
            "no": 3,
            "summary": "想用看电影作为休息，减少短视频",
            "detail": "昨晚用投影看电影后，我想到以后也可以把电影当休息消遣，主要想尽量减少刷短视频的时间。",
            "embedding_sha256": "9d5a79b54133dcbc0606ed35a87fddb596835bd4160e2fb2f7d8bb099d8b602a"
          }
        ]
