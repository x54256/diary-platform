    [
      "E048",
      {
        "id": "e8c71220-00b3-4392-a990-314368bc386e",
        "user_id": "2d7e382a-db46-45b3-b0c5-5c8ded2cc1f7",
        "run_id": "ba62698e-1c95-4709-9acf-48e142f01602",
        "run_status": "POINTS_READY",
        "diary_id": "2ae44b75-b2d4-4bf7-9fca-e809580d5ab8",
        "diary_date": "2026-09-25",
        "occurred_on": null,
        "source_order": 9,
        "title": "觉得小廖近期花钱多，准备提醒她看看资产情况",
        "run_source_sha256": "110839cd7e92526b1a7754b3dc2f12b84a2abd678119253f5494dd75ccf5c851",
        "points": [
          {
            "id": "4b2d9732-26ce-4b77-b16e-c98d34409455",
            "no": 1,
            "summary": "对小廖临近离职还花钱多感到不满",
            "detail": "小廖快辞职、快没工作了，却买得越来越多，吃饭外卖挑贵的、出去玩选最高档，两千多也不问。我觉得没收入还这样花太不负责，也担心到时就要花我的钱。不过目前是她自己的钱，我没办法干涉，提醒就好。",
            "embedding_sha256": "d8a4f8342d746390fa77bb610e4dfa5e38dfb34f5b59fe02b5fe4a6854a83432"
          },
          {
            "id": "934b8723-a12e-47bf-88e3-2dee737b2bc2",
            "no": 2,
            "summary": "盘点大额消费后，也觉得并非每一笔都太多",
            "detail": "我算她近期大钱：相机一万多只用一次，投影仪两三千，为京东补贴买了些杂物，这次旅行两千多。细想旅行也还好，主要相机、投影花得多，但平常吃的也贵，前阵给上大学的妹妹送笔记本也花不少。\n\n还有一次吃贵阳菜还是什么，花了不少，我该给她七百饭钱还未转，准备一会回去转。汪苏泷香港两张票花很多，又买到十月二日广州票还要看，三日又去桂林。",
            "embedding_sha256": "e080a70c92d043edcdb7c5259131893a097f9a25181b60dce5c687f039867d13"
          },
          {
            "id": "3f968703-f076-48db-b1d8-b140b873b313",
            "no": 3,
            "summary": "怀疑小廖已是负资产，准备提醒她自己核算",
            "detail": "算过这些开销，我感觉她应该已是负资产。回去想问问，让她查资产，自己看清后悠着花。都快没收入，不能还这样花；目前自己能做的就是提醒。",
            "embedding_sha256": "57e459af44de0f999cfce8f1f38312ee20b27e4c2678dd0493c26ad8cc5ba4c6"
          }
        ]
      }
    ],
    [
