  "events": [
    [
      "E028",
      {
        "id": "08ebf16a-1744-46f7-9b44-a15778746ba7",
        "user_id": "2d7e382a-db46-45b3-b0c5-5c8ded2cc1f7",
        "run_id": "303c17c0-9f33-4d26-9fce-2acd7fef5e85",
        "run_status": "POINTS_READY",
        "diary_id": "5f9d35f3-387b-43e6-bb0a-5207f73b65f0",
        "diary_date": "2026-09-27",
        "occurred_on": null,
        "source_order": 0,
        "title": "收拾东西去清远度假，入住被树木环绕的酒店",
        "run_source_sha256": "56daa2509a155bf8eddbd2eb67ba6e734781d27a4976da527782ed9a44c925af",
        "points": [
          {
            "id": "e495930f-bd3e-4feb-809a-45cfbe2c32a3",
            "no": 1,
            "summary": "收拾食物和行李，带猫狗去清远度假",
            "detail": "颂梅周四晚来例假，最近身体不太好，虽坚强没表现，我觉得仍要照顾。周六九月二十六起床后收拾，切西瓜、把前一天买的葡萄洗好、装起来，把此前零食、行李放车上；热前一天剩的蒜香排骨和蔬菜，吃完歇会，一点多带多多、哒哒出发去清远酒店。",
            "embedding_sha256": "5ba020871200e87ea6d723801c73ac1749c9877617bbac722d37d565ac09912b"
          },
          {
            "id": "f89ef1d1-3e61-460c-a8e9-723bcd8123b2",
            "no": 2,
            "summary": "酒店亲近自然让我放松，房间和院子住着也不错",
            "detail": "酒店房间、走道被树环绕，有蓝天白云、绿水，心旷神怡，立刻放松，比城市高楼少压力，更近田园自然。\n\n房间五十多平方米、带院子。我先估院子三十、总共八十左右，后来觉得院子没三十，合计应七十左右。两人带猫狗住，一到房间开阳台门，哒哒出去大小便，最后我也没收拾。整体感觉挺好。",
            "embedding_sha256": "149dc31ad18c2dcc962d2efae0087a39b64bc4871c8709710f90de2148a04b41"
          }
        ]
      }
    ],
    [
      "E029",
      {
        "id": "fef8cb25-1834-4583-99c2-9b92c5efa3e6",
        "user_id": "2d7e382a-db46-45b3-b0c5-5c8ded2cc1f7",
        "run_id": "303c17c0-9f33-4d26-9fce-2acd7fef5e85",
        "run_status": "POINTS_READY",
        "diary_id": "5f9d35f3-387b-43e6-bb0a-5207f73b65f0",
        "diary_date": "2026-09-27",
        "occurred_on": null,
        "source_order": 1,
        "title": "和父母讨论自行服药的问题，约好周三让医生评估",
        "run_source_sha256": "56daa2509a155bf8eddbd2eb67ba6e734781d27a4976da527782ed9a44c925af",
        "points": [
          {
            "id": "e66a2ac1-47ab-477b-86fe-3ad272c816da",
            "no": 1,
            "summary": "同事服阿司匹林不能直接洗牙的经历，引出停药需医生评估",
            "detail": "去清远路上，颂梅从“刘欢因心脏病去世”的消息聊心脏病，再说共同前同事亭汉近期做搭桥、要吃阿司匹林。他洗牙时医生问用药，得知后没洗，说可能出血不止。颂梅说要先找心脏科评估能否停、停多久。\n\n这让我想起以前问爸爸，他吃阿司匹林、降压药和中成药，并非医生开，是妈妈让吃。那时我上网查，看到“吃了不能停，因为血管已扩张、停有危险”的说法；这次才知道能否停应由医生评估。",
            "embedding_sha256": "463f4699201fa41e759946e50aacfd7b26d3fa5daa9f8eb6449b8a7ece3bb371"
          },
          {
            "id": "d572f8e5-cfb3-4d6d-8144-394ea7a931e5",
            "no": 2,
            "summary": "觉得妈妈让爸爸自行服药、爸爸照做很不负责",
            "detail": "妈妈在东方医院做过护士，不知听谁说过五十要吃阿司匹林扩血管，又担心奶奶高血压、糖尿病、心脏病遗传，就让爸爸吃。我看来爸爸除高压一百五十、低压八十的高血压外没别的毛病，觉得是瞎吃，听妈妈理论真无语。\n\n爸爸常说“是药三分毒”、劝人少吃，自己却听妈妈吃四五年，也不怕把自己药死，让我发愁，还好这次想起，不然不知吃到何时。",
            "embedding_sha256": "7ecd529d8a6716cdf55fb2effaf0283f49d40443c4526fc5897e45bfc541c46f"
          },
          {
            "id": "135bdd51-a667-42c3-bc17-b481ac0b4068",
            "no": 3,
            "summary": "爸爸骨科就诊后，已约下周三拍核磁",
            "detail": "到酒店给家打电话，想问爸爸看腰结果、给他们看酒店，也问阿司匹林。爸爸说骨科听症状后让拍片，本说 X 光，他提核磁，医生说需排队不能马上出结果，他说那就排，最后约下周三早上。",
            "embedding_sha256": "78a41bef8f6cabe584822865f4b370f7ba14d2e228f728602676b6cfe23bceeb"
          },
          {
            "id": "f585b3d1-cfcc-4150-82ff-25454358e2e9",
            "no": 4,
            "summary": "问出爸爸自行减药，也想到妈妈擅自停甲亢药的经历",
            "detail": "问爸爸为何用阿司匹林，妈妈仍说怕高血压及家族遗传。我问她是医生吗，怎能随便开药，也责怪爸爸听她就吃。感觉她并非不知错，却听不进、继续狡辩。\n\n爸爸已吃四五年，从一天一片自行改两天一片。我觉得一个个都是“神医”，自己定药还减药。妈妈也是，甲亢吃药觉得好便停，两三年、三四年不复诊，今年好不容易去，医生说是见过最严重的一个。这两个“神医”真让我服气。",
            "embedding_sha256": "c03001bf5da2d3f7327ac63ed8b8663fbdf899ded0b829b303c7a7472d28ff42"
          },
          {
            "id": "16bb7387-1dd2-406b-80d5-d1f4d6329fd6",
            "no": 5,
            "summary": "询问豆包后，约好周三让心脏科决定是否继续用药",
            "detail": "了解后问豆包，回答是爸爸不能自行决定继续，也不能随便停，应找心脏科评估和检查。我便约他们周三拍完核磁再挂心脏科，告知高血压、自行服阿司匹林四五年，请医生决定能否停。两人答应，妈妈说上午休息会陪去。\n\n爸爸却又说现在就不吃了，我更着急，觉得再随意停是在害自己，强调听医生决定，别瞎定，对自己一点不负责。",
            "embedding_sha256": "b908e5627df74cf688cb4de7c438021f9368626edcc74ba07fa735d6d268c742"
          },
          {
            "id": "9ea6788a-d4ce-42a9-a2cf-012f916b2795",
            "no": 6,
            "summary": "向妈妈说明，好心也可能因无知造成伤害",
            "detail": "妈妈一直说自己不会害我们，都是好心。我说她主观确实不想害，但无知仍会害人，举农村老太太烧水给孩子洗澡、把孩子烫死的例子：并非想杀孙子，可好意也能造成伤害。最后仍说好周三就医，让医生评估用药。",
            "embedding_sha256": "248714be522088bce8f89b6d7123984fec09373c5fbefdb9e14b2510fabd81ce"
          }
        ]
      }
    ],
    [
      "E030",
      {
        "id": "fb514bed-9e00-4727-a29b-889e58a31122",
        "user_id": "2d7e382a-db46-45b3-b0c5-5c8ded2cc1f7",
        "run_id": "303c17c0-9f33-4d26-9fce-2acd7fef5e85",
